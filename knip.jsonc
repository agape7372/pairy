    "src/components/editor/text/index.ts",
    "src/components/pages/HomeClient.tsx",
    "src/components/providers/ErrorBoundaryProvider.tsx",
    "src/components/whisper/index.ts",
    "src/components/whisper/WhisperNotification.tsx",
